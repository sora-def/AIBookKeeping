# DeepSeek API Key：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 模型：deepseek-v4-pro（旗舰）或 deepseek-flash（更快更便宜）
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.3
MEMORY_WINDOW=20

# 正式环境请用 MySQL（USE_SQLITE=0）。本地快速体验可设 USE_SQLITE=1。
USE_SQLITE=0

# MySQL 连接。请先创建数据库：CREATE DATABASE aibookkeeping DEFAULT CHARSET utf8mb4;
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=aibookkeeping

# JWT
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=168

# 可选：默认月度预算提示（单位：分）。0 表示不启用预算提醒
DEFAULT_MONTHLY_BUDGET_CENTS=0

# 前端页面来源（多个用逗号分隔，不要尾斜杠）。
# 生产（ailife）：CORS_ORIGINS=https://ailife.xzygames.com
# 本地跨机调试示例：CORS_ORIGINS=http://192.168.0.140:5173
CORS_ORIGINS=https://ailife.xzygames.com
