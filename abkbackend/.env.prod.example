# 生产环境配置（服务器使用本文件）
# - 本地开发：使用同目录 .env（有 .env 时不会读本文件）
# - 服务器：不要放 .env，保留本文件即可；或 ABK_ENV_FILE=.env.prod.example
# 注意：本文件可进仓库，切勿填真实密钥。

# DeepSeek API Key：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 模型：deepseek-v4-pro 或 deepseek-v4-flash
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.3
MEMORY_WINDOW=20

# 生产请用 MySQL
USE_SQLITE=0

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=aibookkeeping

# 生产务必换成足够长的随机串
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=168

DEFAULT_MONTHLY_BUDGET_CENTS=0

# 与 Nginx 同域时，浏览器同源请求一般不依赖 CORS；
# 仍建议显式写上生产前端域名（含 https，不要尾斜杠）
CORS_ORIGINS=https://ailife.xzygames.com
